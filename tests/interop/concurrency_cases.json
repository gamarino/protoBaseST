    {
      "id": "cs-read-vs-blind",
      "row": "Counted set: a read-modify-write while the other blindly adds",
      "setup": [["set root", "c", {"counted set": ["e", "e", "f"]}]],
      "a": [["counted set ops", "c", "read", "add", "g"]],
      "b": [["counted set ops", "c", "blind", "add", "e"]],
