      "a": [["reuse committed", "d", "ka", 1, "kb", 2]],
      "b": [["blind dict set root", "d", "kc", 3]],
      "roots": ["d"], "mutables": [],
      "expected": {"outcome": "A=committed B=committed", "dump": ["root d = {'ka': 1, 'kb': 2}"]}
