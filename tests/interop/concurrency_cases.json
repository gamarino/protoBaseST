      "setup": [["new mutable", "m", 0]],
      "a": [["remove mutable", "m"]],
      "b": [["remove mutable", "m"]],
      "roots": [], "mutables": ["m"],
      "expected": {"outcome": "A=committed B=committed", "dump": ["mutable m = absent"]}
    },
    {
      "id": "reuse-committed",
      "row": "A collection committed, then reused in a later blind write (D33)",
