      "a": [["counted set ops", "c", "blind", "add", 1.0, "remove", 1, "add", 1, "add", "f", "remove", "f", "remove", "f"]],
      "b": [["counted set ops", "c", "blind", "add", 1, "add", 1, "remove", "f"]],
